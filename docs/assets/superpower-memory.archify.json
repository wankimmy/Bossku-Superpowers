  "mainPath": ["remember", "sync", "project", "brief"],
  "nodes": [
    { "id": "remember", "lane": "agents", "col": 0, "type": "backend", "label": "Saved notes", "sublabel": "decisions, plans, lessons", "width": 164 },
    { "id": "automem", "lane": "agents", "col": 1, "type": "database", "label": "Claude's memory", "sublabel": "what it learns", "width": 150 },
    { "id": "rules", "lane": "agents", "col": 2, "type": "security", "label": "Your rules", "sublabel": "CLAUDE.md, AGENTS.md", "width": 150 },
    { "id": "sync", "lane": "vault", "col": 1, "type": "backend", "label": "Auto-sync", "sublabel": "after every session", "width": 150 },
    { "id": "project", "lane": "vault", "col": 2, "type": "database", "label": "One folder per project", "sublabel": "BosskuAI / project", "width": 178 },
    { "id": "index", "lane": "vault", "col": 3, "type": "frontend", "label": "Index.md", "sublabel": "links to everything", "width": 150 },
