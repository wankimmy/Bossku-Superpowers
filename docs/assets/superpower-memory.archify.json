    { "id": "mirror-memory", "from": "automem", "to": "sync", "role": "branch", "variant": "dashed" },
    { "id": "mirror-rules", "from": "rules", "to": "sync", "role": "branch", "variant": "dashed" },
    { "id": "link", "from": "project", "to": "index", "role": "branch" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Copies, never moves", "items": ["Your originals stay where they are.", "Secrets are blanked out of the copies."] },
    { "dot": "emerald", "title": "Tidy by default", "items": ["Sub-repos land in their project's folder.", "`bossku vault tidy` cleans up old clutter, with a backup."] }
